{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-write-file"
  ]
}
